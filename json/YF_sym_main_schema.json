{
  "name": "YahooFinanceNewsSelector",
  "baseSelector": "section.mainContent section.container div.news-stream ul.stream-items li",

  "fields": [
    {
      "name": "Title",
      "selector": "div a",
      "type": "attribute",
      "attribute": "title"
    },
    {
      "name": "Teaser",
      "selector": "div div img",
      "type": "attribute",
      "attribute": "alt"
    },
    {
      "name": "Ext_url",
      "selector": "div a",
      "type": "attribute",
      "attribute": "href"
    },
    {
      "name": "Publisher",
      "selector": "div section.container div div div",
      "type": "text"
    },
    {
      "name": "Date",
      "selector": "div section.container div div div",
      "type": "text"
    }
  ]
}